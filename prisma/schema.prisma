generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Sale {
  id        Int      @id @default(autoincrement())
  date      DateTime
  bouquet   String
  color     String
  quantity  Int
  price     Float
  createdAt DateTime @default(now())
}

model Expense {
  id        Int      @id @default(autoincrement())
  date      DateTime
  category  String
  item      String
  cost      Float
  createdAt DateTime @default(now())
}